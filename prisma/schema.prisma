generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  category    String   // Agent, Casting, Regisseur, Kollege, etc.
  email       String?
  phone       String?
  company     String?
  notes       String?
  lastContact DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
}

model Application {
  id          String   @id @default(cuid())
  role        String
  production  String
  status      String   @default("Beworben") // Anfrage, Beworben, Self Tape, Recall, Callback, Gebucht, Abgesagt
  applyDate   DateTime @default(now())
  notes       String?
  material    String?  // Welches Material wurde verlangt
  followUpAt  DateTime?
  deadline    DateTime? // z.B. Self-Tape-Abgabe
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  events      Event[]
}

model Event {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("Sonstiges") // Casting, Dreh, Probe, Auftritt, Training, Meeting, Sonstiges
  date          DateTime
  endDate       DateTime?
  location      String?
  notes         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Task {
  id            String    @id @default(cuid())
  title         String
  done          Boolean   @default(false)
  dueDate       DateTime?
  priority      String    @default("Normal") // Hoch, Normal, Niedrig
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  role        String?
  status      String   @default("Laufend") // Laufend, Abgeschlossen, Geplant
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  events      Event[]
}