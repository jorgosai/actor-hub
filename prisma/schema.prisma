generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  contacts     Contact[]
  applications Application[]
  projects     Project[]
  tasks        Task[]
  events       Event[]
  materials    Material[]
  goals        Goal[]
  wishes       Wish[]
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  category    String   // Agent, Casting, Regisseur, Kollege, etc.
  email       String?
  phone       String?
  company     String?
  notes       String?
  lastContact DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Application {
  id          String   @id @default(cuid())
  role        String
  production  String
  status      String   @default("Beworben") // Anfrage, Beworben, Self Tape, Recall, Callback, Gebucht, Abgesagt
  applyDate   DateTime @default(now())
  notes       String?
  material    String?  // Welches Material wurde verlangt
  followUpAt  DateTime?
  deadline    DateTime? // z.B. Self-Tape-Abgabe
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  events      Event[]
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Goal {
  id         String    @id @default(cuid())
  title      String
  horizon    String    @default("Mittelfristig") // Kurzfristig, Mittelfristig, Langfristig
  done       Boolean   @default(false)
  targetDate DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Wish {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("Rolle") // Rolle, Produktion, Regisseur, Agentur
  achieved  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Material {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("Sonstiges") // Showreel, Headshot, Vita, Voice Demo, Self Tape, Presse, Sonstiges
  url       String?
  version   String?  // z.B. "2026", "V2"
  current   Boolean  @default(true) // aktuelle Version?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("Sonstiges") // Casting, Dreh, Probe, Auftritt, Training, Meeting, Sonstiges
  date          DateTime
  endDate       DateTime?
  location      String?
  notes         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  done          Boolean   @default(false)
  dueDate       DateTime?
  priority      String    @default("Normal") // Hoch, Normal, Niedrig
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  role        String?
  status      String   @default("Laufend") // Laufend, Abgeschlossen, Geplant
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  events      Event[]
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}